// Omadora user config for Niri. The image's defaults in /etc/niri/config.kdl keep
// updating for everyone; Noctalia's theme colors layer on top. Add your own
// settings below the includes to override either.
include "/etc/niri/config.kdl"
include "~/.config/niri/noctalia.kdl"

// Round the border/focus ring to match the windows' rounded corners,
// and clip window contents to that shape so square-cornered apps match too.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

input {
    keyboard {
        xkb {
            // Make Caps Lock an additional Ctrl key.
            options "ctrl:nocaps"
        }
    }

    touchpad {
        // This section replaces the system touchpad section entirely (it isn't
        // merged), so leaving out "tap" disables tap-to-click.
        natural-scroll
        // Two-finger click = right click, three-finger click = middle click.
        click-method "clickfinger"
    }
}
